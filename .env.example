# URL base da Mediway API — SEM o sufixo /api/v1.
# Copie este arquivo para `.env` (ou `.env.local`) e ajuste conforme o alvo:
#
#   Emulador Android ......... http://10.0.2.2:8080
#   Simulador iOS ............ http://localhost:8080
#   Dispositivo físico ...... http://SEU_IP_NA_LAN:8080   (ex.: http://192.168.0.12:8080)
#   Homologação / produção .. https://SEU_HOST
#
# Prioridade de resolução (ver src/config/env.js):
#   EXPO_PUBLIC_API_URL  >  app.json > expo.extra.apiUrl  >  fallback dev

EXPO_PUBLIC_API_URL=http://10.0.2.2:8080
